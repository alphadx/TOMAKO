# =============================================================
# Docker – Variables de infraestructura
# Usado por docker-compose.yml para configurar contenedores
# =============================================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=63BA4C1CC123456
MYSQL_DATABASE=tomako
MYSQL_USER=tomako
MYSQL_PASSWORD=63BA4C1CC123456
MYSQL_PORT=3307

# --- Puertos de la aplicación ---
APP_PORT=8080

# --- Overrides PHP para dentro de Docker ---
# En el contenedor, la BD es el servicio "db", no localhost
YII_DB_HOST=db
YII_DB_PORT=3306
YII_DB_NAME=tomako
YII_DB_USER=tomako
YII_DB_PASSWORD=63BA4C1CC123456
APP_ENV=dev
APP_DEBUG=1
