# =============================================================
# PHP / Yii – Variables de la aplicación
# Cargado por Dotenv en index.php (web) y yii (console)
# =============================================================

# --- Puertos (necesarios para docker-compose.yml) ---
APP_PORT=8080
MYSQL_PORT=3307

# --- Base de datos (valores por defecto fuera de Docker) ---
YII_DB_HOST=localhost
YII_DB_PORT=3307
YII_DB_NAME=tomako
YII_DB_USER=tomako
YII_DB_PASSWORD=63BA4C1CC123456

# --- Entorno de la aplicación ---
APP_ENV=prod
APP_DEBUG=true

# --- Seguridad ---
SECRET_KEY=63BA4C1CC123456
COOKIE_VALIDATION_KEY=f31WAHoKwfOFTaLg163BA4C1CC123456
TS_ADMIN_PASSWORD=F319445AFB

# --- Proxy / Seguridad de sesión ---
TRUSTED_PROXY_HOSTS=*
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Strict

# --- Timeouts (segundos) ---
SESSION_TIMEOUT=1800
AUTH_TIMEOUT=1800